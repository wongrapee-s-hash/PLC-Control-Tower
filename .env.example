# --- Supabase (optional) -----------------------------------------------------
# Leave these two values empty to run the system against the built-in
# offline demo dataset instead of a live PostgreSQL instance.
# Copy this file to `.env.local` and fill the values in once you have applied
# `supabase/schema.sql` and `supabase/seed.sql` to a project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
